{
  "name": "voyara-loyalty",
  "version": "0.1.0",
  "private": true,
  "description": "Voyara — a blockchain-powered travel and lifestyle loyalty network.",
  "scripts": {
    "dev": "concurrently -k -s first -n chain,web -c green,cyan \"npm:chain\" \"npm:web\"",
    "dev:web": "next dev",
    "chain": "hardhat node",
    "chain:compile": "hardhat compile",
    "chain:deploy": "hardhat run scripts/deploy.js --network localhost",
    "web": "wait-on tcp:127.0.0.1:8545 && hardhat run scripts/deploy.js --network localhost && next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "ethers": "6.17.0",
    "lucide-react": "1.70.0",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-ethers": "3.1.3",
    "@openzeppelin/contracts": "5.6.1",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "concurrently": "10.0.7",
    "hardhat": "2.29.1",
    "tailwindcss": "4.3.5",
    "typescript": "^5.9.0",
    "wait-on": "9.5.1"
  }
}
